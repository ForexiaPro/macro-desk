# From https://discord.com/developers/applications → your app → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot → Reset Token. Needed by scripts/register.js, and by /alerts (it creates the channel webhook).
# Without it the server still answers every other command.
DISCORD_BOT_TOKEN=
# Optional: register the commands in one server only, at once (for testing)
DISCORD_GUILD_ID=
PORT=8080
